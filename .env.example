# PostgreSQL connection
DATABASE_URL="postgresql://edura:edura@localhost:5432/edura"
# Separate database used by integration tests
TEST_DATABASE_URL="postgresql://edura:edura@localhost:5432/edura_test"
# Separate database used by Playwright end-to-end tests
E2E_DATABASE_URL="postgresql://edura:edura@localhost:5432/edura_e2e"
# Random secret (>= 32 chars) for session signing
BETTER_AUTH_SECRET="change-me-to-a-long-random-string-32-chars"
# Public URL of the app
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional: Anthropic API key for AI assistant features
ANTHROPIC_API_KEY=""
# Optional: override the Claude model used by the assistant (default: claude-sonnet-5)
ANTHROPIC_MODEL=""
# Optional: SMTP for email notifications (leave empty to log emails to console)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Edura <no-reply@edura.local>"
# Secret for triggering scheduled jobs via /api/jobs
CRON_SECRET="change-me"
